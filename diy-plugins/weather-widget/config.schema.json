{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "locationName": { "type": "string", "title": "地点名称", "description": "显示在组件中的自定义地点名称。", "default": "上海" },
    "latitude": { "type": "number", "title": "纬度", "minimum": -90, "maximum": 90, "default": 31.2304 },
    "longitude": { "type": "number", "title": "经度", "minimum": -180, "maximum": 180, "default": 121.4737 },
    "temperatureUnit": { "type": "string", "title": "温度单位", "enum": ["celsius", "fahrenheit"], "default": "celsius" },
    "showWind": { "type": "boolean", "title": "显示风速", "default": true }
  }
}
